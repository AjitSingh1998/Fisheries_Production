
$(document).ready(function(e) {
	$('body').off('click', '.save_row');
	$('body').off('click', '.edit_row');
	$('body').off('click', '.delete_row');
	
	var fisherman_data = '';
	$('.select-fisherman').select2({
	  placeholder: "Select Fisherman",
	  ajax: {
		url: site_url+'dailytoll/fisherman',
		dataType: 'json',
