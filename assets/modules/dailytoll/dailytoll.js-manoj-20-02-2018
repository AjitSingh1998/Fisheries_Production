	$('.datepicker').datepicker({
		format: 'dd/mm/yyyy',
		autoclose: true,
		todayHighlight: true
	});
	
	$('.export_data').on('click', function(){
		$("table.table").table2excel({
			filename: 'Daily Toll Info Detail'
		});
	});
	
	$('.print_data').on('click', function(){
		$("table.table").print({
			stylesheet: base_url+"assets/css/print.css",
